# ============================================
# SkillSense — Root .gitignore
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
.python-version

# ---------- Node / Frontend ----------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Environment & Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ---------- IDE / Editor ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- ML / Data artifacts ----------
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.tflite
*.model
wandb/
mlruns/
lightning_logs/

# ---------- Large files that shouldn't be in git ----------
*.zip
*.tar.gz
*.rar
*.7z

# ---------- Auth service local state ----------
frontend/server/data/

# ---------- Scraping artifacts ----------
# Raw JSON archives are large — keep CSVs, ignore JSON duplicates
skillsense_job_data/raw/**/*.json

# ---------- Session / dev logs ----------
SESSION_LOG.md

# ---------- Prompt files (dev notes, not source code) ----------
SkillSense_Job_Scraping_and_Role_Grouping_ETL_Prompt.md
