# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=skillsense
DB_USER=skillsense
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ML artifact paths are relative to the project root; defaults match
# models/artifacts/ produced by `python models/phase2d_final_model.py`
ML_MODEL_PATH=models/artifacts/best_model.joblib
ML_ROLE_ENCODER_PATH=models/artifacts/role_encoder.joblib
ML_FEATURE_LIST_PATH=models/artifacts/feature_list.joblib
